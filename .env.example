# 이 파일을 .env 로 복사한 뒤 값을 채워주세요. (.env 는 git 에 올라가지 않습니다)
#
# 공공데이터포털 인증키
#   data.go.kr > 마이페이지 > 오픈API > 인증키 발급현황 > "일반 인증키 (Decoding)" 값
#   ※ Encoding 키(%2B, %3D 가 섞인 값)를 넣어도 스크립트가 알아서 디코딩합니다.
#   쓰는 곳: node scripts/fetch-api-data.mjs 41   (데이터 수집 전용, 브라우저로 나가지 않음)
DATA_GO_KR_KEY=

# 아래 두 개는 .env 에 넣지 않아도 됩니다.
# 앱 실행 후 우측 상단 "API 키" 버튼에서 입력하면 브라우저(localStorage)에만 저장됩니다.
# 배포본에 키를 박고 싶을 때만 사용하세요. (빌드 결과물에 그대로 노출됩니다)
VITE_GROQ_API_KEY=
VITE_KAKAO_JS_KEY=
